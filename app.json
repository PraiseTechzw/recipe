{
  "expo": {
    "name": "Zimbabwe Traditional Recipes",
    "slug": "tasteofzimbabwe",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tasteofzimbabwe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.appixiasoftwares.tasteofzimbabwe",
      "infoPlist": {}
    },
    "android": {
      "package": "com.appixiasoftwares.tasteofzimbabwe",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#F5EBD8",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow access to the camera to add images to recipes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F5EBD8",
          "dark": {
            "backgroundColor": "#173A2A"
          }
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "402af6cd-7c51-4df1-a17c-04875cb1ea37"
      }
    },
    "owner": "camusmarketzw"
  }
}
