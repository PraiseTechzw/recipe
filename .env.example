# Rename this file to .env and fill in your values
# This private key is used only by Supabase Functions; never rename it to EXPO_PUBLIC_*.
OPENROUTER_API_KEY=your_openrouter_api_key_here
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Legacy key name remains supported for older local Supabase projects:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostHog public client configuration
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_posthog_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog server-side AI Observability configuration for Supabase Functions.
# Use the same public project configuration as the client, without an EXPO_PUBLIC_ prefix.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
